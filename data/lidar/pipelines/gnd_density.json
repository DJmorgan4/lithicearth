{
  "pipeline": [
    { "type": "readers.las", "filename": "data/lidar/las/*.las" },
    { "type": "filters.merge" },
    { "type": "filters.range", "limits": "Classification[2:2]" },
    { "type": "writers.gdal",
      "filename": "data/lidar/derived/gnd_density.tif",
      "resolution": 1.0, "output_type": "count", "nodata": 0 }
  ]
}
