{
  "pipeline": [
    { "type": "readers.las", "filename": "data/lidar/las/*.las" },
    { "type": "filters.merge" },
    { "type": "filters.range", "limits": "Classification[2:2]" },
    { "type": "writers.gdal",
      "filename": "data/lidar/dtm/inomata_1m_be.tif",
      "resolution": 1.0, "output_type": "idw",
      "window_size": 3, "nodata": -9999 }
  ]
}
